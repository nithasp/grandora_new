# Copy to .env and fill in. The server refuses to start when a required value is missing or too
# short. Empty values count as "not set".

# Environment: dev | test | production
ENV=dev
PORT=3000

# Database: set DATABASE_URL (managed provider) or the POSTGRES_* values (docker compose up -d)
# DATABASE_URL=postgresql://user:password@host:5432/database
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_DB=grandora_dev
POSTGRES_USER=grandora_user
POSTGRES_PASSWORD=grandora_pass
# TLS to the database: off (local) | verify | no-verify
DATABASE_SSL=off
# DATABASE_SSL_CA="-----BEGIN CERTIFICATE-----\n...\n-----END CERTIFICATE-----"

# Secrets: 32+ characters each. Generate with:
# node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
TOKEN_SECRET=
PASSWORD_PEPPER=
SALT_ROUNDS=10

# JWT access token (sent as the Authorization header) and the refresh cookie that renews it
ACCESS_TOKEN_EXPIRY=15m
REFRESH_TOKEN_EXPIRY_DAYS=7
# strict locally; production defaults to none because the website and the API sit on different sites
REFRESH_COOKIE_SAMESITE=

# Browser origins allowed to call the API (comma-separated) and the website URL used for payment return pages
ALLOWED_ORIGIN=http://localhost:4200
FRONTEND_URL=http://localhost:4200
# Public URL of this API, used for locally stored uploads (STORAGE_DRIVER=local)
PUBLIC_API_URL=http://localhost:3000
TRUST_PROXY=1
LOG_LEVEL=info
JSON_BODY_LIMIT=1mb
API_RATE_LIMIT=500
AUTH_RATE_LIMIT=20
DEMO_RATE_LIMIT=100
# Apollo Sandbox at /api/v1/graph (always off in production unless set to true)
GRAPHQL_SANDBOX=true

# Demo login: every new browser tab of the website signs in to this shared account
DEMO_LOGIN_ENABLED=true
DEMO_EMAIL=demo@grandora.games
# Optional: set (12+ characters) only if you want to sign in as the demo account by hand
DEMO_PASSWORD=

# ---------------------------------------------------------------------------------------------
# Omise (Opn Payments) — https://dashboard.omise.co → Keys. Use test keys first (pkey_test_ / skey_test_).
# Live keys (pkey_ / skey_) charge real money; the smallest package is ฿20, Omise's minimum charge.
OMISE_PUBLIC_KEY=
OMISE_SECRET_KEY=
# Dashboard → Webhooks: endpoint https://<your-api>/api/v1/payments/omise/webhook, then copy its secret here
OMISE_WEBHOOK_SECRET=
OMISE_API_VERSION=2019-05-29
# Methods shown at checkout. Each one must also be enabled on your Omise account.
OMISE_PAYMENT_METHODS=card,promptpay,truemoney_jumpapp,rabbit_linepay,shopeepay,alipay,wechat_pay,mobile_banking_kbank,mobile_banking_scb,mobile_banking_bbl,mobile_banking_bay,mobile_banking_ktb

# ---------------------------------------------------------------------------------------------
# Cloudflare R2 — https://dash.cloudflare.com → R2 → Manage API tokens (Object Read & Write)
# Every uploaded, replaced or deleted image goes to this bucket. Leave empty to store files in
# ./uploads instead (development only; production refuses uploads without R2).
STORAGE_DRIVER=
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=grandora-uploads
# Public bucket URL: the r2.dev subdomain or a custom domain, e.g. https://pub-xxxxxxxx.r2.dev
R2_PUBLIC_URL=
UPLOAD_MAX_MB=5
