{
  "name": "grandora-backend",
  "version": "1.0.0",
  "description": "NestJS + GraphQL + PostgreSQL API for the Grandora website: JWT auth, demo login, MYGG Coins / Grando wallet, Omise payments and Cloudflare R2 uploads",
  "private": true,
  "license": "UNLICENSED",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "nest build",
    "start": "node --enable-source-maps dist/main.js",
    "start:dev": "nest start --watch",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "test": "tsx --test \"src/**/*.spec.ts\"",
    "migrate:up": "db-migrate --config database.js up",
    "migrate:down": "db-migrate --config database.js down",
    "migrate:reset": "db-migrate --config database.js reset",
    "migrate:prod": "db-migrate --config database.js --env production up",
    "seed": "tsx src/scripts/seed.ts",
    "db:setup": "npm run migrate:up && npm run seed",
    "release": "npm run migrate:prod && node dist/scripts/seed.js --if-empty"
  },
  "dependencies": {
    "@apollo/server": "^5.5.2",
    "@as-integrations/express5": "^1.1.2",
    "@aws-sdk/client-s3": "^3.1173.0",
    "@nestjs/apollo": "^13.4.5",
    "@nestjs/common": "^11.2.11",
    "@nestjs/core": "^11.2.11",
    "@nestjs/graphql": "^13.4.5",
    "@nestjs/platform-express": "^11.2.11",
    "@nestjs/throttler": "^6.8.0",
    "bcrypt": "^6.0.0",
    "cookie-parser": "^1.4.7",
    "db-migrate": "^0.11.14",
    "db-migrate-pg": "^1.5.2",
    "dotenv": "^16.6.1",
    "graphql": "^16.15.0",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.3",
    "nestjs-pino": "^5.3.2",
    "pg": "^8.23.1",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@nestjs/cli": "^11.0.24",
    "@nestjs/schematics": "^11.1.0",
    "@types/bcrypt": "^6.0.0",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.3.0",
    "@types/node": "^22.20.5",
    "@types/pg": "^8.15.6",
    "eslint": "^10.15.0",
    "eslint-config-prettier": "^10.1.8",
    "pino-pretty": "^13.2.0",
    "prettier": "^3.10.1",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.73.0"
  }
}
